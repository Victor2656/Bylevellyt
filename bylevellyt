local angle = 0

local function IsPartOfCharacter(part)
    if not Settings.IgnorePlayerParts then return false end
    local current = part.Parent
    while current do
        if current:FindFirstChild("Humanoid") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function PassesFilters(part)
    if not part:IsA("BasePart") then return false end
    if Settings.TargetSpecialBlock then
        if part.Name == "Part" and part.ClassName == "Part" and math.abs(part.Transparency - 0.9) < 0.05 then
            return true
        end
        return false
    end
    if Settings.IgnoreTerrain and part:IsA("Terrain") then return false end
    if IsPartOfCharacter(part) then return false end
    if Settings.FilterClassName ~= "All" then
        if part.ClassName ~= Settings.FilterClassName then return false end
    end
    if Settings.FilterName ~= "" then
        if not string.find(string.lower(part.Name), string.lower(Settings.FilterName)) then
            return false
        end
    end
    if Settings.OnlyInvisible then
        if part.Transparency < 0.5 then return false end
    end
    if not Settings.ShowInvisible then
        if part.Transparency >= 1 then return false end
    end
    return true
end

local function GetTracerOrigin()
    local origin = Settings.TracerOrigin
    if origin == "Bottom" then return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    elseif origin == "Top" then return Vector2.new(Camera.ViewportSize.X / 2, 0)
    elseif origin == "Mouse" then return UserInputService:GetMouseLocation()
    else return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) end
end

local function GetCurrentColor(colorType)
    if Settings.RainbowEnabled then
        if colorType == "box" and Settings.RainbowBoxes then return RainbowColor end
        if colorType == "tracer" and Settings.RainbowTracers then return RainbowColor end
        if colorType == "text" and Settings.RainbowText then return RainbowColor end
    end
    if colorType == "box" then return Settings.ESPColor end
    if colorType == "tracer" then return Settings.TracerColor end
    if colorType == "text" then return Settings.TextColor end
    return Settings.ESPColor
end

local function GetBlockColor(part)
    if part.Transparency >= 0.5 then return Settings.InvisibleColor end
    return GetCurrentColor("box")
end

local function CreateBlockESP(part)
    if BlockDrawings[part] then return end
    local box = {
        TopLeft = Drawing.new("Line"), TopRight = Drawing.new("Line"),
        BottomLeft = Drawing.new("Line"), BottomRight = Drawing.new("Line"),
        Left = Drawing.new("Line"), Right = Drawing.new("Line"),
        Top = Drawing.new("Line"), Bottom = Drawing.new("Line"),
    }
    for _, line in pairs(box) do line.Visible = false; line.Color = Settings.ESPColor; line.Thickness = Settings.BoxThickness end
    local tracer = Drawing.new("Line")
    tracer.Visible = false; tracer.Color = Settings.TracerColor; tracer.Thickness = Settings.TracerThickness
    local info = { Name = Drawing.new("Text"), Distance = Drawing.new("Text"), ClassName = Drawing.new("Text"), Extra = Drawing.new("Text") }
    for _, text in pairs(info) do text.Visible = false; text.Center = true; text.Size = Settings.TextSize; text.Color = Settings.TextColor; text.Font = Settings.TextFont; text.Outline = true end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Settings.HighlightFillColor; highlight.OutlineColor = Settings.HighlightOutlineColor
    highlight.FillTransparency = Settings.HighlightFillTransparency; highlight.OutlineTransparency = Settings.HighlightOutlineTransparency
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; highlight.Enabled = false
    BlockHighlights[part] = highlight
    BlockDrawings[part] = { Box = box, Tracer = tracer, Info = info }
end

local function RemoveBlockESP(part)
    local esp = BlockDrawings[part]
    if esp then
        for _, obj in pairs(esp.Box) do pcall(function() obj:Remove() end) end
        pcall(function() esp.Tracer:Remove() end)
        for _, obj in pairs(esp.Info) do pcall(function() obj:Remove() end) end
        BlockDrawings[part] = nil
    end
    local hl = BlockHighlights[part]
    if hl then pcall(function() hl:Destroy() end); BlockHighlights[part] = nil end
end

local function HideBlockESP(part)
    local esp = BlockDrawings[part]
    if not esp then return end
    for _, obj in pairs(esp.Box) do obj.Visible = false end
    esp.Tracer.Visible = false
    for _, obj in pairs(esp.Info) do obj.Visible = false end
    local hl = BlockHighlights[part]
    if hl then hl.Enabled = false end
end

local function UpdateBlockESP(part)
    if not Settings.Enabled then return end
    local esp = BlockDrawings[part]
    if not esp then return end
    if not part or not part.Parent then RemoveBlockESP(part); return end
    local partPos = part.Position
    local camPos = Camera.CFrame.Position
    local distance = (partPos - camPos).Magnitude
    if distance > Settings.MaxDistance then HideBlockESP(part); return end
    local screenPos, onScreen = Camera:WorldToViewportPoint(partPos)
    if not onScreen then HideBlockESP(part); return end
    local cf = part.CFrame
    local size = part.Size
    local boxColor = GetBlockColor(part)
    local top = Camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y / 2, 0)).Position)
    local bottom = Camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y / 2, 0)).Position)
    local screenHeight = math.abs(bottom.Y - top.Y)
    local boxWidth = math.max(screenHeight * 0.65, 8)
    local boxPosition = Vector2.new(top.X - boxWidth / 2, top.Y)
    local boxSize = Vector2.new(boxWidth, math.max(screenHeight, 4))

    for _, obj in pairs(esp.Box) do obj.Visible = false end

    if Settings.BoxESP then
        if Settings.BoxStyle == "Corner" then
            local cornerSize = boxWidth * 0.25
            esp.Box.TopLeft.From = boxPosition; esp.Box.TopLeft.To = boxPosition + Vector2.new(cornerSize, 0); esp.Box.TopLeft.Visible = true
            esp.Box.Left.From = boxPosition; esp.Box.Left.To = boxPosition + Vector2.new(0, cornerSize); esp.Box.Left.Visible = true
            esp.Box.TopRight.From = boxPosition + Vector2.new(boxSize.X, 0); esp.Box.TopRight.To = boxPosition + Vector2.new(boxSize.X - cornerSize, 0); esp.Box.TopRight.Visible = true
            esp.Box.Right.From = boxPosition + Vector2.new(boxSize.X, 0); esp.Box.Right.To = boxPosition + Vector2.new(boxSize.X, cornerSize); esp.Box.Right.Visible = true
            esp.Box.BottomLeft.From = boxPosition + Vector2.new(0, boxSize.Y); esp.Box.BottomLeft.To = boxPosition + Vector2.new(cornerSize, boxSize.Y); esp.Box.BottomLeft.Visible = true
            esp.Box.Top.From = boxPosition + Vector2.new(0, boxSize.Y); esp.Box.Top.To = boxPosition + Vector2.new(0, boxSize.Y - cornerSize); esp.Box.Top.Visible = true
            esp.Box.BottomRight.From = boxPosition + Vector2.new(boxSize.X, boxSize.Y); esp.Box.BottomRight.To = boxPosition + Vector2.new(boxSize.X - cornerSize, boxSize.Y); esp.Box.BottomRight.Visible = true
            esp.Box.Bottom.From = boxPosition + Vector2.new(boxSize.X, boxSize.Y); esp.Box.Bottom.To = boxPosition + Vector2.new(boxSize.X, boxSize.Y - cornerSize); esp.Box.Bottom.Visible = true
        end
        for _, obj in pairs(esp.Box) do
            if obj.Visible then obj.Color = boxColor; obj.Thickness = Settings.BoxThickness end
        end
    end

    if Settings.TracerESP then
        esp.Tracer.From = GetTracerOrigin(); esp.Tracer.To = Vector2.new(screenPos.X, screenPos.Y)
        esp.Tracer.Color = GetCurrentColor("tracer"); esp.Tracer.Thickness = Settings.TracerThickness; esp.Tracer.Visible = true
    else esp.Tracer.Visible = false end

    local textColor = GetCurrentColor("text")
    local topY = top and top.Y or screenPos.Y
    local currentY = topY - 16

    if Settings.NameESP then
        esp.Info.Name.Text = part.Name; esp.Info.Name.Position = Vector2.new(screenPos.X, currentY)
        esp.Info.Name.Color = textColor; esp.Info.Name.Size = Settings.TextSize; esp.Info.Name.Visible = true
        currentY = currentY - 14
    else esp.Info.Name.Visible = false end

    if Settings.ShowClassName then
        esp.Info.ClassName.Text = "[" .. part.ClassName .. "]" .. (Settings.ShowTransparency and part.Transparency > 0 and " T:" .. string.format("%.1f", part.Transparency) or "")
        esp.Info.ClassName.Position = Vector2.new(screenPos.X, currentY); esp.Info.ClassName.Color = part.Transparency >= 0.5 and Settings.InvisibleColor or Color3.fromRGB(180, 180, 180)
        esp.Info.ClassName.Size = Settings.TextSize - 2; esp.Info.ClassName.Visible = true
        currentY = currentY - 13
    else esp.Info.ClassName.Visible = false end

    if Settings.ShowDistance then
        esp.Info.Distance.Text = "[" .. math.floor(distance) .. (Settings.DistanceUnit == "studs" and " studs" or "m") .. "]"
        esp.Info.Distance.Position = Vector2.new(screenPos.X, currentY); esp.Info.Distance.Color = Color3.fromRGB(200, 200, 200)
        esp.Info.Distance.Size = Settings.TextSize - 2; esp.Info.Distance.Visible = true
    else esp.Info.Distance.Visible = false end
    esp.Info.Extra.Visible = false

    local hl = BlockHighlights[part]
    if hl then
        if Settings.HighlightEnabled then
            hl.Parent = part; hl.FillColor = Settings.HighlightFillColor; hl.OutlineColor = Settings.HighlightOutlineColor
            hl.FillTransparency = Settings.HighlightFillTransparency; hl.OutlineTransparency = Settings.HighlightOutlineTransparency; hl.Enabled = true
        else hl.Enabled = false end
    end
end

local function ScanWorkspace()
    for part, _ in pairs(BlockDrawings) do
        if not part or not part.Parent or not PassesFilters(part) then RemoveBlockESP(part) end
    end
    if not Settings.Enabled then return end
    local camPos = Camera.CFrame.Position
    local validParts = {}
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and PassesFilters(descendant) then
            local dist = (descendant.Position - camPos).Magnitude
            if dist <= Settings.MaxDistance then table.insert(validParts, {part = descendant, distance = dist}) end
        end
    end
    table.sort(validParts, function(a, b) return a.distance < b.distance end)
    local newTracked = {}
    for i = 1, math.min(#validParts, Settings.MaxBlocks) do
        local part = validParts[i].part
        if not BlockDrawings[part] then CreateBlockESP(part) end
        newTracked[part] = true
    end
    for part, _ in pairs(BlockDrawings) do
        if not newTracked[part] then RemoveBlockESP(part) end
    end
    TrackedBlocks = newTracked
end

local function DisableAllESP()
    for part, _ in pairs(BlockDrawings) do HideBlockESP(part) end
end

local function CleanupAllESP()
    for part, _ in pairs(BlockDrawings) do RemoveBlockESP(part) end
    BlockDrawings = {}; BlockHighlights = {}; TrackedBlocks = {}
end

