local lastUpdate = 0
table.insert(Connections, RunService.RenderStepped:Connect(function()
    if IsUnloaded then return end
    if not Settings or not Settings.Enabled then DisableAllESP(); return end
    local currentTime = tick()
    if currentTime - lastUpdate >= Settings.RefreshRate then
        for part, _ in pairs(BlockDrawings) do
            if part and part.Parent then UpdateBlockESP(part) else RemoveBlockESP(part) end
        end
        lastUpdate = currentTime
    end
end))

-- FUNÇÃO MAGNÉTICA PARA NÃO BUGAR O JOGADOR LOCAL
local function PreventCollisionWithPlayer(block, char)
    if not char then return end
    for _, charPart in ipairs(char:GetDescendants()) do
        if charPart:IsA("BasePart") then
            local constraintName = "NCC_" .. charPart.Name
            if not block:FindFirstChild(constraintName) then
                local ncc = Instance.new("NoCollisionConstraint")
                ncc.Name = constraintName
                ncc.Part0 = block
                ncc.Part1 = charPart
                ncc.Parent = block
            end
        end
    end
end

-- SIMULAR TOQUE NO BLOCO PARA GANHAR NETWORK OWNERSHIP
local touchedParts = {}
local function SimulateTouch(part, root)
    if touchedParts[part] then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, part, 0) -- 0 = Touch começou
            task.delay(0.1, function()
                pcall(function()
                    if part and part.Parent and root and root.Parent then
                        firetouchinterest(root, part, 1) -- 1 = Touch terminou
                    end
                end)
            end)
        end
    end)
    touchedParts[part] = true
end

-- LOOP DO MAGNETO - COM SISTEMA DE OWNERSHIP
table.insert(Connections, RunService.Heartbeat:Connect(function(deltaTime)
    if IsUnloaded or not Settings.MagnetoEnabled then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local partsList = {}
    for part, _ in pairs(BlockDrawings) do
        if part and part.Parent then table.insert(partsList, part) end
    end
    
    if #partsList == 0 then return end

    if Settings.MagnetoMode == "Freeze" then
        for _, part in ipairs(partsList) do
            pcall(function()
                PreventCollisionWithPlayer(part, char)
                SimulateTouch(part, root)
                part.Anchored = false
                part.CanCollide = true 
                part.Massless = true 
                
                local dist = (part.Position - root.Position).Magnitude
                
                if dist > 5 then
                    -- FASE 1: Puxar com velocidade (ganha ownership do servidor)
                    local direction = (root.Position - part.Position).Unit
                    part.AssemblyLinearVelocity = direction * 500
                    part.AssemblyAngularVelocity = Vector3.zero
                else
                    -- FASE 2: Já está perto, travar no jogador
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                    part.CFrame = root.CFrame
                end
            end)
        end
    elseif Settings.MagnetoMode == "Extreme" then
        angle = angle + math.rad(10000 * deltaTime)
        
        for i, part in ipairs(partsList) do
            pcall(function()
                PreventCollisionWithPlayer(part, char)
                SimulateTouch(part, root)
                part.Anchored = false
                part.CanCollide = true 
                part.Massless = true
                
                -- BOLA GIRATÓRIA INSTANTÂNEA - não espera, já coloca dentro e gira!
                -- Pequena velocidade pra cima pra manter a física viva
                part.AssemblyLinearVelocity = Vector3.new(0, 25, 0)
                
                -- Trava o bloco DENTRO do jogador e GIRA VISUALMENTE com CFrame
                part.CFrame = root.CFrame * CFrame.Angles(
                    angle * 3,   -- Gira no eixo X
                    -angle * 4,  -- Gira no eixo Y (anti-horário rápido)
                    angle * 2    -- Gira no eixo Z
                )
                
                -- Mantém a velocidade angular física extrema para garantir o fling
                part.AssemblyAngularVelocity = Vector3.new(
                    10000,   -- Giro no eixo X = lança pra CIMA
                    -10000,  -- Giro no eixo Y = lança pra FRENTE (anti-horário)
                    10000    -- Giro no eixo Z = força extra lateral
                )
            end)
        end
    end
end))

